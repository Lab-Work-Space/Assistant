# Names only. Copy to .env.local (git-ignored) and fill in. One file for both CLI and Discord runs on the Mac.
# Bot secrets
# One token + app id per persona (suffix = persona id upper case). DISCORD_BOT_TOKEN alone is refused in Discord mode.
# DISCORD_BOT_TOKEN_PRAW=
# DISCORD_APP_ID_PRAW=
# System log bot (spec 12.14), optional
# DISCORD_BOT_TOKEN_SYSTEM=
# DISCORD_APP_ID_SYSTEM=
ANTHROPIC_API_KEY=
GOOGLE_API_TOKEN=
# Bot required config
# Absolute path outside the repo and KNOWLEDGE_DIR/LOG_DIR, in a 0700 directory
DATABASE_PATH=
DISCORD_GUILD_ID=
APPROVAL_CHANNEL_ID=
ADMIN_NOTIFY_CHANNEL_ID=
TASKS_CHANNEL_ID=
# Optional: the ⚙️-setting channel for /setting commands (inside CHANNEL_ALLOWLIST; never the #bot-log channel). Unset = /setting refused.
# SETTINGS_CHANNEL_ID=
APPROVER_ROLE_ID=
APPROVER_ROLE_NAME=AI-Admin
DEFAULT_CHEAP_MODEL=google/gemini-3.8-flash
# Tier 2 classifier: Flash-Lite class preferred; confirm id on ai.google.dev
REPLY_TIER2_MODEL=google/gemini-3.8-flash
IMAGE_MODEL=google/gemini-3.1-flash-image
TTS_MODEL=google/gemini-3.8-flash-tts
TTS_VOICE=
STT_PROVIDER=
STT_MODEL=
# Voice (spec 12.12): off by default. Live capture only after the TASK-002 DAVE probe passes.
# VOICE_ENABLED=false
# VOICE_LIVE_CAPTURE=false
# GEMINI_PAID_TIER_CONFIRMED=false   # set true only after billing is active on the Google Cloud project (STT_PROVIDER=gemini)
# GOOGLE_STT_API_KEY=            # only when STT_PROVIDER=google-stt
# VOICE_CHUNK_S=30
# VOICE_SILENCE_FLUSH_MS=1500
# VOICE_MIN_SEGMENT_MS=500
# VOICE_MAX_PENDING_CHUNKS=6
# VOICE_MAX_SESSION_MIN=120
# VOICE_NOTICE_DELAY_S=10
# Discord rollout (spec 12): allowlist of channel/category ids, coexist (default) or full, intake persona
CHANNEL_ALLOWLIST=
# ROLLOUT_MODE=coexist
# PERSONA_NAME_SUFFIX=
# INTAKE_PERSONA=praw
# Reply streaming: typing (default, typing indicator then one message) or edit (placeholder message, then live edits)
# STREAM_MODE=typing
