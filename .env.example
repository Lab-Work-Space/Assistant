# Role "assistant" on database "assistant"; from the container the shared PostgreSQL is host.docker.internal:4231
DATABASE_URL=
ANTHROPIC_API_KEY=
# Optional: workspace id (wrkspc_...), required when the API key is organization-scoped
ANTHROPIC_WORKSPACE_ID=
GEMINI_API_KEY=
# 32 random bytes, base64: openssl rand -base64 32
CONFIG_MASTER_KEY=
GUILD_ID=
# Discord role id of the Bot Admin role (admin is identified by id, never by name)
BOT_ADMIN_ROLE_ID=
HEALTH_PORT=8080
HEALTH_HOST=127.0.0.1
LOG_LEVEL=info
# Praw's sandboxed workspace (default data/workspace/praw under the working directory)
PRAW_WORKSPACE_DIR=
# ClickUp tools. A personal token starts with pk_. Two modes (a token alone leaves ClickUp off):
#   list mode:      CLICKUP_LIST_ID = the one list the assistant may read and write (CLICKUP_TEAM_ID is ignored)
#   workspace mode: CLICKUP_TEAM_ID = the workspace id, CLICKUP_LIST_ID empty: every project of that workspace; every write still needs approval
#   all-workspaces: CLICKUP_TEAM_ID = all (exactly, lower case), CLICKUP_LIST_ID empty: every workspace the token can see (at most 10; more at boot means off); every write still needs approval
#                   Use a dedicated ClickUp member token that belongs only to the workspaces you mean: a workspace the token's account joins later is included automatically.
CLICKUP_API_TOKEN=
CLICKUP_LIST_ID=
CLICKUP_TEAM_ID=
# Receipt export to Google Sheets (optional; both needed). URL must be https://script.google.com/macros/s/<id>/exec (an Apps Script web app); the secret is sent in the POST body only. Without them there is no sheets_append_receipt tool; extract_receipt still posts the table and CSV.
GOOGLE_SHEETS_WEBAPP_URL=
GOOGLE_SHEETS_WEBAPP_SECRET=
# A missing token disables that department
BOT_TOKEN_HQ=
BOT_TOKEN_RND=
BOT_TOKEN_SOFTWARE=
BOT_TOKEN_IT=
BOT_TOKEN_MARKETING=
BOT_TOKEN_SALES=
BOT_TOKEN_HR=
BOT_TOKEN_FINANCE=
BOT_TOKEN_OPS=
BOT_TOKEN_PRAW=

# GitHub App (read tools; one installation on selected repos only, no workflows/administration permission). App ID (or client ID), installation id,
# and the private key as a FILE (mode 0600, owned by the app user, not a symlink): GITHUB_APP_PRIVATE_KEY_PATH. GITHUB_APP_PRIVATE_KEY (PEM text, \n escapes) is the fallback.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_PRIVATE_KEY=
# Music (optional): absolute path of a yt-dlp cookies file from a throwaway (non-owner) YouTube account, mounted read-only, mode 0600.
YTDLP_COOKIES_FILE=
# Media sidecar unix socket (production: /run/media-ipc/media.sock). Leave blank on the owner Mac: the local
# yt-dlp/ffmpeg are used there, and refused inside a container (music and voice turn off with "media sidecar not configured").
MEDIA_SOCKET=
