{
  "name": "assistant",
  "version": "0.1.0",
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp -R db/migrations dist/db/ && cp -R vendor dist/ && cp -R prompts/system prompts/heads prompts/members prompts/fragments dist/prompts/ && cp tools/plugins/github/deploy-repos.json dist/tools/plugins/github/",
    "test": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "start": "node dist/main.js",
    "dev": "bash scripts/dev.sh",
    "local:db": "bash scripts/dev.sh db up",
    "local:db:down": "bash scripts/dev.sh db down",
    "local:chrome": "bash scripts/dev.sh chrome up",
    "local:chrome:down": "bash scripts/dev.sh chrome down",
    "local:ws": "bash scripts/dev.sh ws up",
    "local:ws:down": "bash scripts/dev.sh ws down",
    "local:render": "bash scripts/dev.sh render up",
    "local:render:down": "bash scripts/dev.sh render down",
    "local:media": "bash scripts/dev.sh media up",
    "local:media:down": "bash scripts/dev.sh media down",
    "chrome:e2e": "bash scripts/chrome-e2e.sh",
    "chrome:smoke": "CHROME_ACCESS_TOKEN=$(bash scripts/chrome-token.sh) node dist/scripts/chrome-smoke.js",
    "chrome:scan": "bash scripts/chrome-scan.sh",
    "tokens:local": "bash scripts/set-tokens.sh --local",
    "probe:local": "bash scripts/probe-local-cli.sh",
    "migrate": "node dist/db/migrate.js",
    "rotate-master-key": "node dist/scripts/rotate-master-key.js",
    "import:discord-bot": "node --disable-warning=ExperimentalWarning dist/scripts/import-discord-bot.js"
  },
  "type": "module",
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@discordjs/voice": "0.19.2",
    "@google/genai": "2.32.0",
    "@snazzah/davey": "0.1.12",
    "discord.js": "^14.28.0",
    "gray-matter": "^4.0.3",
    "msedge-tts": "2.1.1",
    "opusscript": "0.0.8",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "prism-media": "1.3.5",
    "puppeteer-core": "25.16.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "2.9.1"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  }
}
